{
  "name": "design-token-manager",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Design Token Manager plugin for Penpot",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate-fonts": "node scripts/generate-font-catalog.mjs",
    "predev": "npm run generate-fonts",
    "dev": "vite build --watch",
    "prebuild": "npm run generate-fonts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@penpot/plugin-styles": "1.5.0",
    "@penpot/plugin-types": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-live-preview": "^0.4.0",
    "vitest": "^3.2.7"
  }
}
